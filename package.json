{
  "name": "berlin-streckensammler",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "build": "rm -rf dist && bun build src/server.ts --target=bun --production --public-path=/ --outdir=dist",
    "start": "bun dist/server.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "data": "bun scripts/build-data.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
